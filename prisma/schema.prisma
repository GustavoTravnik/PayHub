datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  pixAccounts   PixAccount[]
  transactions  Transaction[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Models
enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  EVP
}

model PixAccount {
  id        String     @id @default(cuid())
  userId    String
  keyType   PixKeyType
  pixKey    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

enum TransactionStatus {
  PENDING
  PAID
  TRANSFER_PENDING
  COMPLETED
  FAILED
}

model Transaction {
  id                 String            @id @default(cuid())
  userId             String
  pixAccountId       String
  amount             Int               // Em centavos
  fee                Int               @default(0) // Taxa retida em centavos
  netAmount          Int               // Valor líquido repassado
  status             TransactionStatus @default(PENDING)
  starkBankInvoiceId String?           @unique
  starkBankTransferId String?          @unique
  qrCode             String?
  brcode             String?           // Copia e Cola
  
  isArchivedByUser   Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  pixAccount PixAccount @relation(fields: [pixAccountId], references: [id])
}
